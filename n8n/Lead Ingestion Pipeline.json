      "name": "Normalize Lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        224,
        96
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are a B2B lead qualification assistant. Analyze the lead and return a quality score from 0-100, a qualification tier (Hot, Warm, or Cold), the primary buying intent as a short phrase, and a one-sentence summary. Weigh urgency, budget signals, company presence, and clarity of requirements."
            },
            {
              "content": "=Name: {{ $json.name }}\nEmail: {{ $json.email }}\nPhone: {{ $json.phone }}\nCompany: {{ $json.company }}\nRequirements: {{ $json.requirements }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "lead_scoring",
              "schema": "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"score\":{\"type\":\"integer\",\"description\":\"Lead quality score from 0 to 100\"},\"qualification\":{\"type\":\"string\",\"enum\":[\"Hot\",\"Warm\",\"Cold\"]},\"intent\":{\"type\":\"string\",\"description\":\"Primary buying intent as a short phrase\"},\"summary\":{\"type\":\"string\",\"description\":\"One-sentence summary of the lead\"}},\"required\":[\"score\",\"qualification\",\"intent\",\"summary\"]}",
              "strict": true
            }
          }
        }
      },
      "id": "fb345f0b-1f37-48e8-96c1-337acba2cfdc",
      "name": "Score & Extract Intent",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        448,
        96
      ],
      "executeOnce": false,
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Normalize Lead').item.json;\n\nlet ai = {};\ntry {\n  const raw = $('Score & Extract Intent').item.json.output[0].content[0].text;\n  ai = typeof raw === 'string' ? JSON.parse(raw) : (raw || {});\n} catch (e) {\n  ai = {};\n}\n\nconst aiScore = Number(ai.score) || 0;\nconst intent = ai.intent || '';\nconst summary = ai.summary || '';\n\n// Rule-based scoring on normalized fields\nconst req = String(lead.requirements || '').toLowerCase();\nlet ruleScore = 0;\nif (lead.email) ruleScore += 15;\nif (lead.phone) ruleScore += 15;\nif (lead.company) ruleScore += 15;\nif (req.length > 40) ruleScore += 15;\nconst signals = ['urgent', 'asap', 'buy', 'purchase', 'budget', 'quote', 'pricing', 'demo', 'trial', 'immediately', 'this week', 'this month'];\nif (signals.some(function (k) { return req.includes(k); })) ruleScore += 40;\nruleScore = Math.min(ruleScore, 100);\n\nconst finalScore = Math.round(aiScore * 0.6 + ruleScore * 0.4);\nconst qualified = finalScore >= 60;\n\nlet qualification = ai.qualification || '';\nif (!qualification) {\n  qualification = finalScore >= 75 ? 'Hot' : finalScore >= 50 ? 'Warm' : 'Cold';\n}\n\nreturn [{\n  json: {\n    name: lead.name || '',\n    email: lead.email || '',\n    phone: lead.phone || '',\n    company: lead.company || '',\n    requirements: lead.requirements || '',\n    ai_score: aiScore,\n    rule_score: ruleScore,\n    final_score: finalScore,\n    qualification: qualification,\n    intent: intent,\n    summary: summary,\n    qualified: qualified,\n  },\n}];"
      },
      "id": "ebf9037c-e09b-458a-a522-63e5fcd80c77",
      "name": "Combine Scoring",
